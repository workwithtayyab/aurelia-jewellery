# Frontend environment variables (Vite).
#
# LOCAL DEVELOPMENT: you can leave everything unset. `npm run dev` talks to
# http://localhost:5001 automatically.
#
# PRODUCTION (Vercel > Project > Settings > Environment Variables):
# VITE_API_URL is REQUIRED. Use the Render backend address: https schema,
# no trailing slash, no /api suffix. The build fails if this is missing or
# points to localhost.
#
#   VITE_API_URL=https://your-backend.onrender.com
#
# Optional: route API calls through Vercel's rewrite (see vercel.json) so
# login cookies are first-party. Use this instead of the URL above:
#
#   VITE_API_URL=same-origin
#
# NOTE: Vite bakes these values in at BUILD time. After changing a variable
# in Vercel you must redeploy for it to take effect.
VITE_API_URL=
