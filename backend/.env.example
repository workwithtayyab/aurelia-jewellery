# ---------------------------------------------------------------
# Copy to .env for local development. On Render, set each of these
# in the service's Environment tab instead (never commit real values).
# ---------------------------------------------------------------

# Render sets PORT automatically. Locally it defaults to 5001.
# PORT=5001

# Set to "production" on Render (cookies become Secure + SameSite=None).
NODE_ENV=development

# MongoDB Atlas connection string.
# Atlas > Network Access must allow Render (0.0.0.0/0 on the free tier).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/aurelia?retryWrites=true&w=majority

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Allowed browser origins, comma separated, NO trailing slash.
# Production: only your real Vercel domain(s). Do not leave localhost in production.
# Local:      http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Order notification emails (Resend)
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend.
ORDER_EMAIL_FROM=Aurelia Jewellery <orders@your-verified-domain.com>
ORDER_NOTIFICATION_EMAIL=you@example.com

# Only used by `npm run create-admin` / `npm run reset-admin-password`.
# Remove from Render's environment after use.
ADMIN_EMAIL=
ADMIN_PASSWORD=
